<Solution>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path=".gitmodules" />
    <File Path="LICENSE.txt" />
    <File Path="README.md" />
  </Folder>
  <Project Path="Inflate/Inflate.csproj">
    <BuildDependency Project="Inflate.Shader/Inflate.Shader.vcxproj" />
  </Project>
  <Project Path="Inflate.Tests/Inflate.Tests.csproj" />
  <Project Path="Inflate.Harness/Inflate.Harness.csproj" />
  <Project Path="Inflate.Shader/Inflate.Shader.vcxproj">
    <BuildType Solution="*|*" Project="Release" />
    <Platform Solution="*|*" Project="Win32" />
  </Project>
  <Project Path="YukkuriMovieMaker.Generator/YukkuriMovieMaker.Generator/YukkuriMovieMaker.Generator.csproj" />
  <Project Path="YukkuriMovieMaker.Generator/YukkuriMovieMaker.Generator.Build/YukkuriMovieMaker.Generator.Build.csproj">
    <BuildType Solution="*|*" Project="Debug" />
    <Platform Solution="*|*" Project="Any CPU" />
  </Project>
</Solution>
